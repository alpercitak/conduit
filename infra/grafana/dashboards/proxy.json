{
  "title": "conduit-proxy",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per Second (by upstream)",
      "targets": [
        {
          "expr": "sum by (upstream) (rate(conduit_requests_total[1m]))"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Error Rate (by upstream)",
      "targets": [
        {
          "expr": "sum by (upstream) (rate(conduit_errors_total[1m]))"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "P95 Latency (by upstream)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, upstream) (rate(conduit_request_duration_seconds_bucket[1m])))"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "P99 Latency (by upstream)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, upstream) (rate(conduit_request_duration_seconds_bucket[1m])))"
        }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Traffic Split (alpha vs beta)",
      "targets": [
        {
          "expr": "sum by (upstream) (rate(conduit_requests_total[1m]))"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    },
    {
      "type": "state-timeline",
      "title": "Breaker State (by upstream)",
      "targets": [
        { "expr": "max by (upstream) (conduit_breaker_state)", "legendFormat": "{{upstream}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "closed", "color": "green" },
                "1": { "text": "half-open", "color": "yellow" },
                "2": { "text": "open", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Routing Score (higher wins)",
      "targets": [
        { "expr": "max by (upstream) (conduit_upstream_score)", "legendFormat": "{{upstream}}" }
      ],
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 }
    }
  ]
}
